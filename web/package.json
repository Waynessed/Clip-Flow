{
  "name": "clipflow-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test:e2e": "playwright test",
    "build:walkthrough": "node ../scripts/walkthrough-data.mjs && tsc -b && vite build --config vite.walkthrough.config.ts",
    "preview:walkthrough": "vite preview --config vite.walkthrough.config.ts",
    "test:walkthrough": "playwright test --config playwright.walkthrough.config.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "@playwright/test": "1.63.0"
  }
}
